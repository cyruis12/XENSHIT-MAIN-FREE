--// CARD CREATION - Glassmorphism Style
local function CreateGlassCard(parent, config)
    config = config or {}
    
    local Card = Create("Frame")
    Card.Size = config.Size or UDim2.new(1, 0, 1, 0)
    Card.Position = config.Position or UDim2.new(0, 0, 0, 0)
    Card.BackgroundColor3 = Colors.Glass
    Card.BackgroundTransparency = config.Transparency or Colors.GlassTransparency
    Card.BorderSizePixel = 0
    Card.Parent = parent
    Corner(Card, config.Radius or 14)
    GlassStroke(Card, 1.5, 0.8)
    GlassGradient(Card)
    Shadow(Card, 0.75, 25)
    
    -- Entrance animation
    Card.AnchorPoint = Vector2.new(0.5, 0.5)
    local finalSize = config.Size or UDim2.new(1, 0, 1, 0)
    local finalPos = config.Position or UDim2.new(0, 0, 0, 0)
    
    Card.Position = finalPos + UDim2.new(0, 0, 0, 30)
    Card.Size = finalSize - UDim2.new(0, 20, 0, 20)
    Card.BackgroundTransparency = 1
    
    task.spawn(function()
        task.wait(config.Delay or 0.1)
        SmoothTween(Card, {
            BackgroundTransparency = config.Transparency or Colors.GlassTransparency,
            Size = finalSize,
            Position = finalPos
        }, 0.6)
    end)
    
    return Card
end

--// BUTTON CREATION - Smooth
local function CreateButton(parent, config)
    config = config or {}
    
    local Button = Create("TextButton")
    Button.Size = config.Size or UDim2.new(0, 100, 0, 35)
    Button.Position = config.Position or UDim2.new(0, 0, 0, 0)
    Button.BackgroundColor3 = config.Color or Colors.Green
    Button.BackgroundTransparency = config.Transparency or 0
    Button.Text = config.Text or "Button"
    Button.TextColor3 = config.TextColor or Color3.fromRGB(0, 0, 0)
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = config.TextSize or 13
    Button.Parent = parent
    Corner(Button, config.Radius or 8)
    
    if config.Glass then
        GlassStroke(Button, 1, 0.7)
        GlassGradient(Button)
    end
    
    -- Smooth hover
    Button.MouseEnter:Connect(function()
        SmoothTween(Button, {
            BackgroundColor3 = config.HoverColor or (config.Color and Color3.new(config.Color.R * 0.8, config.Color.G * 0.8, config.Color.B * 0.8)) or Colors.GreenDark,
            Size = config.Size + UDim2.new(0, 2, 0, 2)
        }, 0.25)
    end)
    
    Button.MouseLeave:Connect(function()
        SmoothTween(Button, {
            BackgroundColor3 = config.Color or Colors.Green,
            Size = config.Size or UDim2.new(0, 100, 0, 35)
        }, 0.25)
    end)
    
    Button.MouseButton1Down:Connect(function()
        SmoothTween(Button, {
            Size = config.Size - UDim2.new(0, 4, 0, 4)
        }, 0.1)
    end)
    
    Button.MouseButton1Up:Connect(function()
        SmoothTween(Button, {
            Size = config.Size or UDim2.new(0, 100, 0, 35)
        }, 0.1)
    end)
    
    if config.Callback then
        Button.MouseButton1Click:Connect(config.Callback)
    end
    
    return Button
end

