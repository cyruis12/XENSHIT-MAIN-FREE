--// WIDGET UI LIBRARY - "NebulaUI"
--// Works perfectly with smooth animations

local NebulaUI = {}
NebulaUI.__index = NebulaUI

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")

-- Theme Colors
local Theme = {
    Background = Color3.fromRGB(18, 18, 22),
    Card = Color3.fromRGB(24, 24, 30),
    CardHover = Color3.fromRGB(32, 32, 40),
    Accent = Color3.fromRGB(99, 102, 241),
    AccentHover = Color3.fromRGB(129, 140, 248),
    Text = Color3.fromRGB(255, 255, 255),
    TextSecondary = Color3.fromRGB(148, 163, 184),
    Border = Color3.fromRGB(38, 38, 48),
    Success = Color3.fromRGB(34, 197, 94),
    Danger = Color3.fromRGB(239, 68, 68)
}

-- Helper Functions
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function Corner(obj, radius)
    local c = Create("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

local function Stroke(obj, thickness, color)
    local s = Create("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or Theme.Border
    s.Transparency = 0
    s.Parent = obj
    return s
end

local function Tween(obj, props, dur)
    local tween = TweenService:Create(obj, 
        TweenInfo.new(dur or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), 
        props
    )
    tween:Play()
    return tween
end

-- Main Window Creator
function NebulaUI:CreateWindow(config)
    config = config or {}
    
    local Window = {}
    Window.__index = Window
    
    -- ScreenGui
    local ScreenGui = Create("ScreenGui")
    ScreenGui.Name = config.Title or "NebulaUI"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Main Frame
    local MainFrame = Create("Frame")
    MainFrame.Size = UDim2.new(0, 600, 0, 400)
    MainFrame.Position = UDim2.new(0.5, -300, 0.5, -200)
    MainFrame.BackgroundColor3 = Theme.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.Parent = ScreenGui
    MainFrame.Active = true
    MainFrame.Draggable = true
    Corner(MainFrame, 12)
    Stroke(MainFrame, 1.5, Theme.Border)
    
    -- Title Bar
    local TitleBar = Create("Frame")
    TitleBar.Size = UDim2.new(1, 0, 0, 45)
    TitleBar.BackgroundColor3 = Theme.Card
    TitleBar.BorderSizePixel = 0
    TitleBar.Parent = MainFrame
    Corner(TitleBar, 12)
    
    -- Title
    local TitleLabel = Create("TextLabel")
    TitleLabel.Size = UDim2.new(0, 300, 1, 0)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = config.Title or "NebulaUI"
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 18
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = TitleBar
    
    -- Minimize Button
    local MinimizeBtn = Create("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    MinimizeBtn.Position = UDim2.new(1, -70, 0.5, -15)
    MinimizeBtn.BackgroundColor3 = Theme.CardHover
    MinimizeBtn.Text = "—"
    MinimizeBtn.TextColor3 = Theme.Text
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.TextSize = 18
    MinimizeBtn.Parent = TitleBar
    Corner(MinimizeBtn, 6)
    
    local Minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        Minimized = not Minimized
        if Minimized then
            Tween(MainFrame, {Size = UDim2.new(0, 600, 0, 45)}, 0.3)
        else
            Tween(MainFrame, {Size = UDim2.new(0, 600, 0, 400)}, 0.3)
        end
    end)
    
    -- Close Button
    local CloseBtn = Create("TextButton")
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -35, 0.5, -15)
    CloseBtn.BackgroundColor3 = Theme.Danger
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Theme.Text
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 20
    CloseBtn.Parent = TitleBar
    Corner(CloseBtn, 6)
    
    CloseBtn.MouseButton1Click:Connect(function()
        Tween(MainFrame, {Size = UDim2.new(0, 0, 0, 0)}, 0.3)
        task.wait(0.3)
        ScreenGui:Destroy()
    end)
    
    -- Navigation Tabs
    local TabBar = Create("Frame")
    TabBar.Size = UDim2.new(1, 0, 0, 40)
    TabBar.Position = UDim2.new(0, 0, 0, 45)
    TabBar.BackgroundColor3 = Theme.Background
    TabBar.BorderSizePixel = 0
    TabBar.Parent = MainFrame
    
    local TabList = Create("UIListLayout")
    TabList.FillDirection = Enum.FillDirection.Horizontal
    TabList.Padding = UDim.new(0, 5)
    TabList.Parent = TabBar
    
    local TabPadding = Create("UIPadding")
    TabPadding.PaddingLeft = UDim.new(0, 10)
    TabPadding.PaddingTop = UDim.new(0, 5)
    TabPadding.Parent = TabBar
    
    -- Content Area
    local ContentArea = Create("Frame")
    ContentArea.Size = UDim2.new(1, -20, 1, -95)
    ContentArea.Position = UDim2.new(0, 10, 0, 95)
    ContentArea.BackgroundColor3 = Theme.Background
    ContentArea.BorderSizePixel = 0
    ContentArea.Parent = MainFrame
    
    -- Storage
    local Tabs = {}
    local TabButtons = {}
    
    -- Tab Function
    function Window:Tab(config)
        config = config or {}
        
        local Tab = {}
        
        -- Tab Button
        local TabBtn = Create("TextButton")
        TabBtn.Size = UDim2.new(0, 100, 0, 30)
        TabBtn.BackgroundColor3 = Theme.Card
        TabBtn.Text = config.Title or "Tab"
        TabBtn.TextColor3 = Theme.TextSecondary
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.Parent = TabBar
        Corner(TabBtn, 6)
        
        -- Tab Content
        local TabContent = Create("ScrollingFrame")
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 4
        TabContent.ScrollBarImageColor3 = Theme.Accent
        TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabContent.Visible = false
        TabContent.Parent = ContentArea
        
        local ContentList = Create("UIListLayout")
        ContentList.Padding = UDim.new(0, 10)
        ContentList.Parent = TabContent
        
        -- Tab Click
        TabBtn.MouseButton1Click:Connect(function()
            for _, btn in pairs(TabButtons) do
                Tween(btn, {BackgroundColor3 = Theme.Card, TextColor3 = Theme.TextSecondary}, 0.2)
            end
            for _, content in pairs(Tabs) do
                content.Visible = false
            end
            
            Tween(TabBtn, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text}, 0.2)
            TabContent.Visible = true
        end)
        
        table.insert(TabButtons, TabBtn)
        table.insert(Tabs, TabContent)
        
        -- Select first tab
        if #TabButtons == 1 then
            TabBtn.BackgroundColor3 = Theme.Accent
            TabBtn.TextColor3 = Theme.Text
            TabContent.Visible = true
        end
        
        -- Section Function
        function Tab:Section(config)
            config = config or {}
            
            local Section = {}
            
            -- Section Container
            local SectionFrame = Create("Frame")
            SectionFrame.Size = UDim2.new(1, 0, 0, 50)
            SectionFrame.BackgroundColor3 = Theme.Card
            SectionFrame.Parent = TabContent
            Corner(SectionFrame, 8)
            Stroke(SectionFrame, 1, Theme.Border)
            
            -- Section Title
            local SectionTitle = Create("TextLabel")
            SectionTitle.Size = UDim2.new(1, -20, 0, 30)
            SectionTitle.Position = UDim2.new(0, 10, 0, 5)
            SectionTitle.BackgroundTransparency = 1
            SectionTitle.Text = config.Title or "Section"
            SectionTitle.TextColor3 = Theme.Text
            SectionTitle.Font = Enum.Font.GothamBold
            SectionTitle.TextSize = 16
            SectionTitle.TextXAlignment = Enum.TextXAlignment.Left
            SectionTitle.Parent = SectionFrame
            
            -- Elements Container
            local ElementsFrame = Create("Frame")
            ElementsFrame.Size = UDim2.new(1, 0, 0, 0)
            ElementsFrame.Position = UDim2.new(0, 0, 0, 40)
            ElementsFrame.BackgroundTransparency = 1
            ElementsFrame.Parent = SectionFrame
            
            local ElementsList = Create("UIListLayout")
            ElementsList.Padding = UDim.new(0, 8)
            ElementsList.Parent = ElementsFrame
            
            local ElementsPadding = Create("UIPadding")
            ElementsPadding.PaddingLeft = UDim.new(0, 10)
            ElementsPadding.PaddingRight = UDim.new(0, 10)
            ElementsPadding.PaddingBottom = UDim.new(0, 10)
            ElementsPadding.Parent = ElementsFrame
            
            -- Update Section Size
            local function UpdateSection()
                local height = 45 + ElementsList.AbsoluteContentSize.Y + 10
                SectionFrame.Size = UDim2.new(1, 0, 0, height)
                TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 20)
            end
            
            ElementsList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSection)
            ContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSection)
            
            -- Button
            function Section:Button(config)
                local Btn = Create("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 35)
                Btn.BackgroundColor3 = Theme.Background
                Btn.Text = config.Name or config.Title or "Button"
                Btn.TextColor3 = Theme.Text
                Btn.Font = Enum.Font.GothamMedium
                Btn.TextSize = 14
                Btn.Parent = ElementsFrame
                Corner(Btn, 6)
                Stroke(Btn, 1, Theme.Border)
                
                Btn.MouseEnter:Connect(function()
                    Tween(Btn, {BackgroundColor3 = Theme.CardHover}, 0.2)
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(Btn, {BackgroundColor3 = Theme.Background}, 0.2)
                end)
                Btn.MouseButton1Click:Connect(function()
                    if config.Callback then config.Callback() end
                end)
                
                return Btn
            end
            
            -- Toggle
            function Section:Toggle(config)
                local ToggleFrame = Create("Frame")
                ToggleFrame.Size = UDim2.new(1, 0, 0, 40)
                ToggleFrame.BackgroundColor3 = Theme.Background
                ToggleFrame.Parent = ElementsFrame
                Corner(ToggleFrame, 6)
                Stroke(ToggleFrame, 1, Theme.Border)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.7, 0, 1, 0)
                Label.Position = UDim2.new(0, 10, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Toggle"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 14
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = ToggleFrame
                
                local ToggleBtn = Create("Frame")
                ToggleBtn.Size = UDim2.new(0, 45, 0, 22)
                ToggleBtn.Position = UDim2.new(1, -55, 0.5, -11)
                ToggleBtn.BackgroundColor3 = Theme.Border
                ToggleBtn.Parent = ToggleFrame
                Corner(ToggleBtn, 11)
                
                local Dot = Create("Frame")
                Dot.Size = UDim2.new(0, 18, 0, 18)
                Dot.Position = UDim2.new(0, 2, 0.5, -9)
                Dot.BackgroundColor3 = Theme.TextSecondary
                Dot.Parent = ToggleBtn
                Corner(Dot, 9)
                
                local State = config.Default or false
                
                local function UpdateToggle()
                    if State then
                        Tween(ToggleBtn, {BackgroundColor3 = Theme.Accent}, 0.2)
                        Tween(Dot, {Position = UDim2.new(1, -20, 0.5, -9), BackgroundColor3 = Theme.Text}, 0.2)
                    else
                        Tween(ToggleBtn, {BackgroundColor3 = Theme.Border}, 0.2)
                        Tween(Dot, {Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = Theme.TextSecondary}, 0.2)
                    end
                end
                
                ToggleFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        State = not State
                        UpdateToggle()
                        if config.Callback then config.Callback(State) end
                    end
                end)
                
                UpdateToggle()
                return ToggleFrame
            end
            
            -- Slider
            function Section:Slider(config)
                local SliderFrame = Create("Frame")
                SliderFrame.Size = UDim2.new(1, 0, 0, 55)
                SliderFrame.BackgroundColor3 = Theme.Background
                SliderFrame.Parent = ElementsFrame
                Corner(SliderFrame, 6)
                Stroke(SliderFrame, 1, Theme.Border)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.7, 0, 0, 20)
                Label.Position = UDim2.new(0, 10, 0, 5)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Slider"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 14
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = SliderFrame
                
                local ValueLabel = Create("TextLabel")
                ValueLabel.Size = UDim2.new(0.3, -20, 0, 20)
                ValueLabel.Position = UDim2.new(0.7, 10, 0, 5)
                ValueLabel.BackgroundTransparency = 1
                ValueLabel.Text = tostring(config.Default or 0)
                ValueLabel.TextColor3 = Theme.Accent
                ValueLabel.Font = Enum.Font.GothamBold
                ValueLabel.TextSize = 14
                ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
                ValueLabel.Parent = SliderFrame
                
                local Bar = Create("Frame")
                Bar.Size = UDim2.new(1, -20, 0, 4)
                Bar.Position = UDim2.new(0, 10, 0, 35)
                Bar.BackgroundColor3 = Theme.Border
                Bar.Parent = SliderFrame
                Corner(Bar, 2)
                
                local Fill = Create("Frame")
                Fill.Size = UDim2.new(0, 0, 1, 0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.Parent = Bar
                Corner(Fill, 2)
                
                local Min = config.Min or 0
                local Max = config.Max or 100
                local Value = config.Default or 0
                
                local function Update()
                    local percent = (Value - Min) / (Max - Min)
                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    ValueLabel.Text = tostring(Value)
                end
                
                local function SetValue(input)
                    local barPos = Bar.AbsolutePosition.X
                    local barSize = Bar.AbsoluteSize.X
                    local mouseX = input.Position.X
                    local percent = math.clamp((mouseX - barPos) / barSize, 0, 1)
                    Value = math.floor(Min + (Max - Min) * percent)
                    Update()
                    if config.Callback then config.Callback(Value) end
                end
                
                Bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        SetValue(input)
                        local conn
                        conn = UserInputService.InputChanged:Connect(function(changed)
                            if changed.UserInputType == Enum.UserInputType.MouseMovement then
                                SetValue(changed)
                            end
                        end)
                        UserInputService.InputEnded:Connect(function(ended)
                            if ended.UserInputType == Enum.UserInputType.MouseButton1 then
                                conn:Disconnect()
                            end
                        end)
                    end
                end)
                
                Update()
                return SliderFrame
            end
            
            -- Dropdown
            function Section:Dropdown(config)
                local DropdownFrame = Create("Frame")
                DropdownFrame.Size = UDim2.new(1, 0, 0, 40)
                DropdownFrame.BackgroundColor3 = Theme.Background
                DropdownFrame.Parent = ElementsFrame
                Corner(DropdownFrame, 6)
                Stroke(DropdownFrame, 1, Theme.Border)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.6, 0, 1, 0)
                Label.Position = UDim2.new(0, 10, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Dropdown"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 14
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = DropdownFrame
                
                local DropBtn = Create("TextButton")
                DropBtn.Size = UDim2.new(0.4, -20, 0, 30)
                DropBtn.Position = UDim2.new(0.6, 10, 0.5, -15)
                DropBtn.BackgroundColor3 = Theme.CardHover
                DropBtn.Text = config.Default or "Select"
                DropBtn.TextColor3 = Theme.Text
                DropBtn.Font = Enum.Font.GothamMedium
                DropBtn.TextSize = 12
                DropBtn.Parent = DropdownFrame
                Corner(DropBtn, 4)
                
                local DropList = Create("ScrollingFrame")
                DropList.Size = UDim2.new(0.4, -20, 0, 0)
                DropList.Position = UDim2.new(0.6, 10, 0, 35)
                DropList.BackgroundColor3 = Theme.CardHover
                DropList.Visible = false
                DropList.ScrollBarThickness = 2
                DropList.ZIndex = 10
                DropList.Parent = DropdownFrame
                Corner(DropList, 4)
                
                local ListLayout = Create("UIListLayout")
                ListLayout.Padding = UDim.new(0, 2)
                ListLayout.Parent = DropList
                
                DropBtn.MouseButton1Click:Connect(function()
                    DropList.Visible = not DropList.Visible
                    if DropList.Visible then
                        DropList.Size = UDim2.new(0.4, -20, 0, math.min(#(config.Options or {}), 5) * 30)
                    else
                        DropList.Size = UDim2.new(0.4, -20, 0, 0)
                    end
                end)
                
                for _, option in pairs(config.Options or {}) do
                    local OptionBtn = Create("TextButton")
                    OptionBtn.Size = UDim2.new(1, -4, 0, 28)
                    OptionBtn.Position = UDim2.new(0, 2, 0, 0)
                    OptionBtn.BackgroundColor3 = Theme.Background
                    OptionBtn.Text = option
                    OptionBtn.TextColor3 = Theme.Text
                    OptionBtn.Font = Enum.Font.GothamMedium
                    OptionBtn.TextSize = 12
                    OptionBtn.Parent = DropList
                    Corner(OptionBtn, 4)
                    
                    OptionBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = option
                        DropList.Visible = false
                        DropList.Size = UDim2.new(0.4, -20, 0, 0)
                        if config.Callback then config.Callback(option) end
                    end)
                end
                
                return DropdownFrame
            end
            
            -- Text Input
            function Section:TextBox(config)
                local InputFrame = Create("Frame")
                InputFrame.Size = UDim2.new(1, 0, 0, 40)
                InputFrame.BackgroundColor3 = Theme.Background
                InputFrame.Parent = ElementsFrame
                Corner(InputFrame, 6)
                Stroke(InputFrame, 1, Theme.Border)
                
                local Input = Create("TextBox")
                Input.Size = UDim2.new(1, -20, 0, 30)
                Input.Position = UDim2.new(0, 10, 0.5, -15)
                Input.BackgroundColor3 = Theme.CardHover
                Input.PlaceholderText = config.Placeholder or "Enter text..."
                Input.Text = ""
                Input.TextColor3 = Theme.Text
                Input.PlaceholderColor3 = Theme.TextSecondary
                Input.Font = Enum.Font.GothamMedium
                Input.TextSize = 13
                Input.Parent = InputFrame
                Corner(Input, 4)
                
                if config.Callback then
                    Input.FocusLost:Connect(function(enterPressed)
                        if enterPressed then
                            config.Callback(Input.Text)
                        end
                    end)
                end
                
                return Input
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- Notification
    function Window:Notify(config)
        local Notif = Create("Frame")
        Notif.Size = UDim2.new(0, 250, 0, 50)
        Notif.Position = UDim2.new(1, -260, 1, -60)
        Notif.BackgroundColor3 = Theme.Card
        Notif.Parent = ScreenGui
        Corner(Notif, 8)
        Stroke(Notif, 1, Theme.Accent)
        
        local Title = Create("TextLabel")
        Title.Size = UDim2.new(1, -20, 0, 20)
        Title.Position = UDim2.new(0, 10, 0, 5)
        Title.BackgroundTransparency = 1
        Title.Text = config.Title or "Notification"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamBold
        Title.TextSize = 14
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = Notif
        
        local Content = Create("TextLabel")
        Content.Size = UDim2.new(1, -20, 0, 20)
        Content.Position = UDim2.new(0, 10, 0, 25)
        Content.BackgroundTransparency = 1
        Content.Text = config.Content or ""
        Content.TextColor3 = Theme.TextSecondary
        Content.Font = Enum.Font.GothamMedium
        Content.TextSize = 12
        Content.TextXAlignment = Enum.TextXAlignment.Left
        Content.Parent = Notif
        
        Notif.Position = UDim2.new(1, 10, 1, -60)
        Tween(Notif, {Position = UDim2.new(1, -260, 1, -60)}, 0.3)
        
        task.wait(config.Duration or 3)
        Tween(Notif, {Position = UDim2.new(1, 10, 1, -60), BackgroundTransparency = 1}, 0.3)
        task.wait(0.3)
        Notif:Destroy()
    end
    
    return Window
end

return NebulaUI
