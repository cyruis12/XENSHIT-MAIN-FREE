                Input.PlaceholderText = config.Placeholder or "Enter text..."
                Input.Text = ""
                Input.TextColor3 = Colors.Text
                Input.PlaceholderColor3 = Colors.TextSecondary
                Input.Font = Enum.Font.GothamMedium
                Input.TextSize = 13
                Input.Parent = InputFrame
                AddCorner(Input, 4)
                
                if config.Callback then
                    Input.FocusLost:Connect(function(enterPressed)
                        if enterPressed then
                            config.Callback(Input.Text)
                        end
                    end)
                end
                
                return Input
            end
            
            -- Paragraph
            function Section:Paragraph(config)
                config = config or {}
                
                local ParagraphFrame = Create("Frame")
                ParagraphFrame.Size = UDim2.new(1, 0, 0, 60)
                ParagraphFrame.BackgroundColor3 = Colors.Background
                ParagraphFrame.Parent = SectionContainer
                AddCorner(ParagraphFrame, 4)
                
                local ParagraphTitle = Create("TextLabel")
                ParagraphTitle.Size = UDim2.new(1, -20, 0, 20)
                ParagraphTitle.Position = UDim2.new(0, 10, 0, 5)
                ParagraphTitle.BackgroundTransparency = 1
                ParagraphTitle.Text = config.Title or ""
                ParagraphTitle.TextColor3 = Colors.Text
                ParagraphTitle.Font = Enum.Font.GothamBold
                ParagraphTitle.TextSize = 13
                ParagraphTitle.TextXAlignment = Enum.TextXAlignment.Left
                ParagraphTitle.Parent = ParagraphFrame
                
                local ParagraphContent = Create("TextLabel")
                ParagraphContent.Size = UDim2.new(1, -20, 0, 30)
                ParagraphContent.Position = UDim2.new(0, 10, 0, 25)
                ParagraphContent.BackgroundTransparency = 1
                ParagraphContent.Text = config.Content or ""
                ParagraphContent.TextColor3 = Colors.TextSecondary
                ParagraphContent.Font = Enum.Font.GothamMedium
                ParagraphContent.TextSize = 11
                ParagraphContent.TextXAlignment = Enum.TextXAlignment.Left
                ParagraphContent.TextWrapped = true
                ParagraphContent.Parent = ParagraphFrame
                
                return ParagraphFrame
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- Notification System
    function Window:Notify(config)
        config = config or {}
        
        local Notification = Create("Frame")
        Notification.Size = UDim2.new(0, 280, 0, 60)
        Notification.Position = UDim2.new(1, -290, 1, -70)
        Notification.BackgroundColor3 = Colors.Card
        Notification.Parent = ScreenGui
        AddCorner(Notification, 8)
        AddStroke(Notification, 1, Colors.Accent)
        
        local NotifIcon = Create("ImageLabel")
        NotifIcon.Size = UDim2.new(0, 30, 0, 30)
        NotifIcon.Position = UDim2.new(0, 10, 0.5, -15)
        NotifIcon.BackgroundColor3 = Colors.Accent
        NotifIcon.Image = config.Icon or "rbxassetid://7733960981"
        NotifIcon.Parent = Notification
        AddCorner(NotifIcon, 4)
        
        local NotifTitle = Create("TextLabel")
        NotifTitle.Size = UDim2.new(1, -60, 0, 20)
        NotifTitle.Position = UDim2.new(0, 50, 0, 8)
        NotifTitle.BackgroundTransparency = 1
        NotifTitle.Text = config.Title or "Notification"
        NotifTitle.TextColor3 = Colors.Text
        NotifTitle.Font = Enum.Font.GothamBold
        NotifTitle.TextSize = 14
        NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
        NotifTitle.Parent = Notification
        
        local NotifContent = Create("TextLabel")
        NotifContent.Size = UDim2.new(1, -60, 0, 25)
        NotifContent.Position = UDim2.new(0, 50, 0, 30)
        NotifContent.BackgroundTransparency = 1
        NotifContent.Text = config.Content or ""
        NotifContent.TextColor3 = Colors.TextSecondary
        NotifContent.Font = Enum.Font.GothamMedium
        NotifContent.TextSize = 11
        NotifContent.TextXAlignment = Enum.TextXAlignment.Left
        NotifContent.TextWrapped = true
        NotifContent.Parent = Notification
        
        -- Slide in animation
        Notification.Position = UDim2.new(1, 10, 1, -70)
        Tween(Notification, {Position = UDim2.new(1, -290, 1, -70)}, 0.3)
        
        task.wait(config.Duration or 3)
        
        -- Slide out
        Tween(Notification, {Position = UDim2.new(1, 10, 1, -70), BackgroundTransparency = 1}, 0.3)
        task.wait(0.3)
        Notification:Destroy()
    end
    
    -- Destroy Window
    function Window:Destroy()
        Tween(MainFrame, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, 0.3)
        task.wait(0.3)
        ScreenGui:Destroy()
    end
    
    Window.ScreenGui = ScreenGui
    Window.MainFrame = MainFrame
    
