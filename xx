--// HELPER FUNCTIONS
local function Create(className, properties)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    return instance
end

local function Corner(instance, radius)
    local corner = Create("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 12)
    corner.Parent = instance
    return corner
end

local function GlassStroke(instance, thickness, transparency)
    local stroke = Create("UIStroke")
    stroke.Thickness = thickness or 1
    stroke.Color = Colors.Border
    stroke.Transparency = transparency or Colors.BorderTransparency
    stroke.Parent = instance
    return stroke
end

local function GlassGradient(instance)
    local gradient = Create("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 210))
    })
    gradient.Transparency = ColorSequence.new({
        ColorSequenceKeypoint.new(0, NumberSequence.new(0.85, 0.85)),
        ColorSequenceKeypoint.new(1, NumberSequence.new(0.95, 0.95))
    })
    gradient.Rotation = 45
    gradient.Parent = instance
    return gradient
end

local function Shadow(instance, transparency, size)
    local shadow = Create("ImageLabel")
    shadow.Size = UDim2.new(1, size or 30, 1, size or 30)
    shadow.Position = UDim2.new(0, -(size or 30)/2, 0, -(size or 30)/2)
    shadow.Image = "rbxassetid://6015897843"
    shadow.ImageTransparency = transparency or 0.6
    shadow.BackgroundTransparency = 1
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(49, 49, 49, 49)
    shadow.ZIndex = -1
    shadow.Parent = instance
    return shadow
end

local function Tween(instance, properties, duration, easing, direction)
    local tweenInfo = TweenInfo.new(
        duration or 0.3,
        easing or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

local function SmoothTween(instance, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or 0.4,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

