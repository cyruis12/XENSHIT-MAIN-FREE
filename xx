TimeLabel.Position = UDim2.new(0, 5, 0, 0)
TimeLabel.BackgroundTransparency = 1
TimeLabel.Text = "9:41"
TimeLabel.TextColor3 = Colors.Text
TimeLabel.Font = Enum.Font.GothamBold
TimeLabel.TextSize = 14
TimeLabel.Parent = TimeWidget

local MuteBtn = Create("TextButton")
MuteBtn.Size = UDim2.new(0, 25, 0, 25)
MuteBtn.Position = UDim2.new(0, 70, 0.5, -12)
MuteBtn.BackgroundColor3 = Colors.Card2
MuteBtn.Text = "🔇"
MuteBtn.TextColor3 = Colors.SubText
MuteBtn.Font = Enum.Font.GothamBold
MuteBtn.TextSize = 12
MuteBtn.Parent = TimeWidget
Corner(MuteBtn, 12)

MuteBtn.MouseButton1Click:Connect(function()
    local muted = MuteBtn.Text == "🔇"
    MuteBtn.Text = muted and "🔊" or "🔇"
    MuteBtn.TextColor3 = muted and Colors.Text or Colors.SubText
end)

--// CLOCK UPDATE
local function UpdateClock()
    while task.wait(1) do
        TimeLabel.Text = os.date("%H:%M")
    end
end

task.spawn(UpdateClock)

--// INITIAL STATUS
UpdateStatus("UI loaded successfully")
UpdateStatus("Welcome, " .. LocalPlayer.Name)

--// MAKE UI RESPONSIVE
local function UpdateResponsive()
    local screenWidth = workspace.CurrentCamera.ViewportSize.X
    if screenWidth < 1200 then
        UIScale.Scale = 0.8
    elseif screenWidth < 800 then
        UIScale.Scale = 0.6
    else
        UIScale.Scale = 1
    end
end

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsive)
UpdateResponsive()

print("Nebula Hub UI loaded successfully")
