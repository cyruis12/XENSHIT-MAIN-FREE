NavLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
NavLayout.VerticalAlignment = Enum.VerticalAlignment.Center
NavLayout.Padding = UDim.new(0, 10)
NavLayout.Parent = NavBar

local NavPadding = Create("UIPadding")
NavPadding.PaddingLeft = UDim.new(0, 10)
NavPadding.PaddingRight = UDim.new(0, 10)
NavPadding.Parent = NavBar

-- Nav buttons
local NavIcons = {
    {Name = "Home", Icon = "⌂"},
    {Name = "Library", Icon = "📚"},
    {Name = "Scripts", Icon = "📜"},
    {Name = "Search", Icon = "🔍"},
    {Name = "Settings", Icon = "⚙"},
    {Name = "Profile", Icon = "👤"}
}

local SelectedNav = nil

for i, navData in pairs(NavIcons) do
    local NavBtn = Create("TextButton")
    NavBtn.Size = UDim2.new(0, 40, 0, 40)
    NavBtn.BackgroundColor3 = Colors.Card2
    NavBtn.Text = navData.Icon
    NavBtn.TextColor3 = Colors.SubText
    NavBtn.Font = Enum.Font.GothamBold
    NavBtn.TextSize = 18
    NavBtn.Parent = NavBar
    Corner(NavBtn, 20)
    
    NavBtn.MouseEnter:Connect(function()
        Tween(NavBtn, {BackgroundColor3 = Colors.Card3, TextColor3 = Colors.Text}, 0.2)
    end)
    
    NavBtn.MouseLeave:Connect(function()
        if SelectedNav ~= NavBtn then
            Tween(NavBtn, {BackgroundColor3 = Colors.Card2, TextColor3 = Colors.SubText}, 0.2)
        end
    end)
    
    NavBtn.MouseButton1Click:Connect(function()
        if SelectedNav then
            Tween(SelectedNav, {BackgroundColor3 = Colors.Card2, TextColor3 = Colors.SubText}, 0.2)
        end
        SelectedNav = NavBtn
        Tween(NavBtn, {BackgroundColor3 = Colors.Accent, TextColor3 = Colors.Text}, 0.2)
        UpdateStatus("Switched to " .. navData.Name)
    end)
end

--// TIME WIDGET
