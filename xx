--// FLOATING WIDGET UI - "AetherUI"
--// Modern, Clean, Floating Design

local AetherUI = {}
AetherUI.__index = AetherUI

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Colors (Modern Dark Theme)
local Theme = {
    Background = Color3.fromRGB(13, 13, 17),
    Card = Color3.fromRGB(23, 23, 30),
    CardHover = Color3.fromRGB(30, 30, 40),
    Accent = Color3.fromRGB(99, 102, 241),
    AccentHover = Color3.fromRGB(139, 92, 246),
    Text = Color3.fromRGB(255, 255, 255),
    SubText = Color3.fromRGB(148, 163, 184),
    Border = Color3.fromRGB(38, 38, 48),
    Success = Color3.fromRGB(34, 197, 94)
}

-- Helper Functions
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function Corner(obj, radius)
    local c = Create("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
    return c
end

local function Tween(obj, props, dur)
    local t = TweenService:Create(obj, TweenInfo.new(dur or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- Main Window
function AetherUI:CreateWindow(config)
    config = config or {}
    
    local Window = {}
    
    -- ScreenGui
    local Gui = Create("ScreenGui")
    Gui.Name = config.Title or "AetherUI"
    Gui.Parent = CoreGui
    Gui.ResetOnSpawn = false
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Main Container
    local Main = Create("Frame")
    Main.Size = UDim2.new(0, 550, 0, 400)
    Main.Position = UDim2.new(0.5, -275, 0.5, -200)
    Main.BackgroundColor3 = Theme.Background
    Main.BorderSizePixel = 0
    Main.Parent = Gui
    Main.Active = true
    Main.Draggable = true
    Main.ClipsDescendants = true
    Corner(Main, 12)
    
    -- Top Bar
    local TopBar = Create("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 50)
    TopBar.BackgroundColor3 = Theme.Card
    TopBar.BorderSizePixel = 0
    TopBar.Parent = Main
    Corner(TopBar, 12)
    
    -- Title
    local Title = Create("TextLabel")
    Title.Size = UDim2.new(1, -120, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = config.Title or "Aether Hub"
    Title.TextColor3 = Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 20
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar
    
    -- Subtitle
    local Subtitle = Create("TextLabel")
    Subtitle.Size = UDim2.new(1, -120, 0, 15)
    Subtitle.Position = UDim2.new(0, 20, 0, 30)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Text = "Welcome, " .. LocalPlayer.Name
    Subtitle.TextColor3 = Theme.SubText
    Subtitle.Font = Enum.Font.GothamMedium
    Subtitle.TextSize = 11
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.Parent = TopBar
    
    -- Close Button
    local CloseBtn = Create("TextButton")
    CloseBtn.Size = UDim2.new(0, 32, 0, 32)
    CloseBtn.Position = UDim2.new(1, -42, 0, 9)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Theme.Text
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 22
    CloseBtn.Parent = TopBar
    Corner(CloseBtn, 8)
    
    CloseBtn.MouseButton1Click:Connect(function()
        Tween(Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.3)
        task.wait(0.3)
        Gui:Destroy()
    end)
    
    -- Tab Navigation (Left Sidebar)
    local Sidebar = Create("Frame")
    Sidebar.Size = UDim2.new(0, 140, 1, -50)
    Sidebar.Position = UDim2.new(0, 0, 0, 50)
    Sidebar.BackgroundColor3 = Theme.Background
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    
    local TabList = Create("UIListLayout")
    TabList.Padding = UDim.new(0, 8)
    TabList.Parent = Sidebar
    
    local TabPadding = Create("UIPadding")
    TabPadding.PaddingLeft = UDim.new(0, 10)
    TabPadding.PaddingTop = UDim.new(0, 10)
    TabPadding.PaddingRight = UDim.new(0, 10)
    TabPadding.Parent = Sidebar
    
    -- Content Area
    local Content = Create("Frame")
    Content.Size = UDim2.new(1, -140, 1, -50)
    Content.Position = UDim2.new(0, 140, 0, 50)
    Content.BackgroundColor3 = Theme.Background
    Content.BorderSizePixel = 0
    Content.Parent = Main
    
    -- Storage
    local Tabs = {}
    local TabButtons = {}
    
    -- Tab Function
    function Window:Tab(config)
        config = config or {}
        
        local Tab = {}
        
        -- Tab Button
        local TabBtn = Create("TextButton")
        TabBtn.Size = UDim2.new(1, 0, 0, 36)
        TabBtn.BackgroundColor3 = Theme.Card
        TabBtn.Text = config.Title or "Tab"
        TabBtn.TextColor3 = Theme.SubText
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.Parent = Sidebar
        Corner(TabBtn, 6)
        
        -- Add padding to text
        local TabPadding = Create("UIPadding")
        TabPadding.PaddingLeft = UDim.new(0, 12)
        TabPadding.Parent = TabBtn
        
        -- Tab Content
        local TabContent = Create("ScrollingFrame")
        TabContent.Size = UDim2.new(1, -20, 1, -20)
        TabContent.Position = UDim2.new(0, 10, 0, 10)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 3
        TabContent.ScrollBarImageColor3 = Theme.Accent
        TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabContent.Visible = false
        TabContent.Parent = Content
        
        local ContentList = Create("UIListLayout")
        ContentList.Padding = UDim.new(0, 10)
        ContentList.Parent = TabContent
        
        -- Tab Click
        TabBtn.MouseButton1Click:Connect(function()
            for _, btn in pairs(TabButtons) do
                Tween(btn, {BackgroundColor3 = Theme.Card, TextColor3 = Theme.SubText}, 0.2)
            end
            for _, tab in pairs(Tabs) do
                tab.Visible = false
            end
            
            Tween(TabBtn, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text}, 0.2)
            TabContent.Visible = true
        end)
        
        table.insert(TabButtons, TabBtn)
        table.insert(Tabs, TabContent)
        
        -- Auto select first tab
        if #TabButtons == 1 then
            TabBtn.BackgroundColor3 = Theme.Accent
            TabBtn.TextColor3 = Theme.Text
            TabContent.Visible = true
        end
        
        -- Section Function
        function Tab:Section(config)
            config = config or {}
            
            local Section = {}
            
            -- Section Frame
            local SectionFrame = Create("Frame")
            SectionFrame.Size = UDim2.new(1, 0, 0, 50)
            SectionFrame.BackgroundColor3 = Theme.Card
            SectionFrame.Parent = TabContent
            Corner(SectionFrame, 8)
            
            -- Section Title
            local SectionTitle = Create("TextLabel")
            SectionTitle.Size = UDim2.new(1, -20, 0, 25)
            SectionTitle.Position = UDim2.new(0, 10, 0, 5)
            SectionTitle.BackgroundTransparency = 1
            SectionTitle.Text = config.Title or "Section"
            SectionTitle.TextColor3 = Theme.Text
            SectionTitle.Font = Enum.Font.GothamBold
            SectionTitle.TextSize = 15
            SectionTitle.TextXAlignment = Enum.TextXAlignment.Left
            SectionTitle.Parent = SectionFrame
            
            -- Elements Container
            local Elements = Create("Frame")
            Elements.Size = UDim2.new(1, 0, 0, 0)
            Elements.Position = UDim2.new(0, 0, 0, 35)
            Elements.BackgroundTransparency = 1
            Elements.Parent = SectionFrame
            
            local ElementsList = Create("UIListLayout")
            ElementsList.Padding = UDim.new(0, 6)
            ElementsList.Parent = Elements
            
            local ElementsPadding = Create("UIPadding")
            ElementsPadding.PaddingLeft = UDim.new(0, 10)
            ElementsPadding.PaddingRight = UDim.new(0, 10)
            ElementsPadding.PaddingBottom = UDim.new(0, 10)
            ElementsPadding.Parent = Elements
            
            -- Update Section Size
            local function UpdateSize()
                local height = 40 + ElementsList.AbsoluteContentSize.Y + 10
                SectionFrame.Size = UDim2.new(1, 0, 0, height)
                TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 20)
            end
            
            ElementsList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSize)
            ContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSize)
            
            -- Button
            function Section:Button(config)
                local Btn = Create("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 34)
                Btn.BackgroundColor3 = Theme.Background
                Btn.Text = config.Name or config.Title or "Button"
                Btn.TextColor3 = Theme.Text
                Btn.Font = Enum.Font.GothamMedium
                Btn.TextSize = 13
                Btn.Parent = Elements
                Corner(Btn, 5)
                
                Btn.MouseEnter:Connect(function()
                    Tween(Btn, {BackgroundColor3 = Theme.CardHover}, 0.2)
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(Btn, {BackgroundColor3 = Theme.Background}, 0.2)
                end)
                Btn.MouseButton1Click:Connect(function()
                    if config.Callback then config.Callback() end
                end)
                
                return Btn
            end
            
            -- Toggle
            function Section:Toggle(config)
                local ToggleFrame = Create("Frame")
                ToggleFrame.Size = UDim2.new(1, 0, 0, 38)
                ToggleFrame.BackgroundColor3 = Theme.Background
                ToggleFrame.Parent = Elements
                Corner(ToggleFrame, 5)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.7, 0, 1, 0)
                Label.Position = UDim2.new(0, 10, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Toggle"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = ToggleFrame
                
                local ToggleBtn = Create("Frame")
                ToggleBtn.Size = UDim2.new(0, 42, 0, 22)
                ToggleBtn.Position = UDim2.new(1, -52, 0.5, -11)
                ToggleBtn.BackgroundColor3 = Theme.Border
                ToggleBtn.Parent = ToggleFrame
                Corner(ToggleBtn, 11)
                
                local Dot = Create("Frame")
                Dot.Size = UDim2.new(0, 18, 0, 18)
                Dot.Position = UDim2.new(0, 2, 0.5, -9)
                Dot.BackgroundColor3 = Theme.SubText
                Dot.Parent = ToggleBtn
                Corner(Dot, 9)
                
                local State = config.Default or false
                
                local function Update()
                    if State then
                        Tween(ToggleBtn, {BackgroundColor3 = Theme.Accent}, 0.2)
                        Tween(Dot, {Position = UDim2.new(1, -20, 0.5, -9), BackgroundColor3 = Theme.Text}, 0.2)
                    else
                        Tween(ToggleBtn, {BackgroundColor3 = Theme.Border}, 0.2)
                        Tween(Dot, {Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = Theme.SubText}, 0.2)
                    end
                end
                
                ToggleFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        State = not State
                        Update()
                        if config.Callback then config.Callback(State) end
                    end
                end)
                
                Update()
                return ToggleFrame
            end
            
            -- Slider
            function Section:Slider(config)
                local SliderFrame = Create("Frame")
                SliderFrame.Size = UDim2.new(1, 0, 0, 50)
                SliderFrame.BackgroundColor3 = Theme.Background
                SliderFrame.Parent = Elements
                Corner(SliderFrame, 5)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.7, 0, 0, 18)
                Label.Position = UDim2.new(0, 10, 0, 5)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Slider"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = SliderFrame
                
                local ValueLabel = Create("TextLabel")
                ValueLabel.Size = UDim2.new(0.3, -20, 0, 18)
                ValueLabel.Position = UDim2.new(0.7, 10, 0, 5)
                ValueLabel.BackgroundTransparency = 1
                ValueLabel.Text = tostring(config.Default or 0)
                ValueLabel.TextColor3 = Theme.Accent
                ValueLabel.Font = Enum.Font.GothamBold
                ValueLabel.TextSize = 13
                ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
                ValueLabel.Parent = SliderFrame
                
                local Bar = Create("Frame")
                Bar.Size = UDim2.new(1, -20, 0, 3)
                Bar.Position = UDim2.new(0, 10, 0, 30)
                Bar.BackgroundColor3 = Theme.Border
                Bar.Parent = SliderFrame
                Corner(Bar, 2)
                
                local Fill = Create("Frame")
                Fill.Size = UDim2.new(0, 0, 1, 0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.Parent = Bar
                Corner(Fill, 2)
                
                local Min = config.Min or 0
                local Max = config.Max or 100
                local Value = config.Default or 0
                
                local function Update()
                    local percent = (Value - Min) / (Max - Min)
                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    ValueLabel.Text = tostring(Value)
                end
                
                local function SetValue(input)
                    local barPos = Bar.AbsolutePosition.X
                    local barSize = Bar.AbsoluteSize.X
                    local mouseX = input.Position.X
                    local percent = math.clamp((mouseX - barPos) / barSize, 0, 1)
                    Value = math.floor(Min + (Max - Min) * percent)
                    Update()
                    if config.Callback then config.Callback(Value) end
                end
                
                Bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        SetValue(input)
                        local conn
                        conn = UserInputService.InputChanged:Connect(function(changed)
                            if changed.UserInputType == Enum.UserInputType.MouseMovement then
                                SetValue(changed)
                            end
                        end)
                        UserInputService.InputEnded:Connect(function(ended)
                            if ended.UserInputType == Enum.UserInputType.MouseButton1 then
                                conn:Disconnect()
                            end
                        end)
                    end
                end)
                
                Update()
                return SliderFrame
            end
            
            -- Dropdown
            function Section:Dropdown(config)
                local DropFrame = Create("Frame")
                DropFrame.Size = UDim2.new(1, 0, 0, 38)
                DropFrame.BackgroundColor3 = Theme.Background
                DropFrame.Parent = Elements
                Corner(DropFrame, 5)
                
                local Label = Create("TextLabel")
                Label.Size = UDim2.new(0.6, 0, 1, 0)
                Label.Position = UDim2.new(0, 10, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = config.Name or config.Title or "Dropdown"
                Label.TextColor3 = Theme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = DropFrame
                
                local DropBtn = Create("TextButton")
                DropBtn.Size = UDim2.new(0.4, -20, 0, 28)
                DropBtn.Position = UDim2.new(0.6, 10, 0.5, -14)
                DropBtn.BackgroundColor3 = Theme.CardHover
                DropBtn.Text = config.Default or "Select"
                DropBtn.TextColor3 = Theme.Text
                DropBtn.Font = Enum.Font.GothamMedium
                DropBtn.TextSize = 12
                DropBtn.Parent = DropFrame
                Corner(DropBtn, 4)
                
                local DropList = Create("ScrollingFrame")
                DropList.Size = UDim2.new(0.4, -20, 0, 0)
                DropList.Position = UDim2.new(0.6, 10, 0, 32)
                DropList.BackgroundColor3 = Theme.CardHover
                DropList.Visible = false
                DropList.ScrollBarThickness = 2
                DropList.ZIndex = 10
                DropList.Parent = DropFrame
                Corner(DropList, 4)
                
                local ListLayout = Create("UIListLayout")
                ListLayout.Padding = UDim.new(0, 2)
                ListLayout.Parent = DropList
                
                DropBtn.MouseButton1Click:Connect(function()
                    DropList.Visible = not DropList.Visible
                    if DropList.Visible then
                        DropList.Size = UDim2.new(0.4, -20, 0, math.min(#(config.Options or {}), 5) * 28)
                    else
                        DropList.Size = UDim2.new(0.4, -20, 0, 0)
                    end
                end)
                
                for _, option in pairs(config.Options or {}) do
                    local OptBtn = Create("TextButton")
                    OptBtn.Size = UDim2.new(1, -4, 0, 26)
                    OptBtn.Position = UDim2.new(0, 2, 0, 0)
                    OptBtn.BackgroundColor3 = Theme.Background
                    OptBtn.Text = option
                    OptBtn.TextColor3 = Theme.Text
                    OptBtn.Font = Enum.Font.GothamMedium
                    OptBtn.TextSize = 11
                    OptBtn.Parent = DropList
                    Corner(OptBtn, 4)
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = option
                        DropList.Visible = false
                        DropList.Size = UDim2.new(0.4, -20, 0, 0)
                        if config.Callback then config.Callback(option) end
                    end)
                end
                
                return DropFrame
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- Notification
    function Window:Notify(config)
        local Notif = Create("Frame")
        Notif.Size = UDim2.new(0, 240, 0, 50)
        Notif.Position = UDim2.new(1, -250, 1, -60)
        Notif.BackgroundColor3 = Theme.Card
        Notif.Parent = Gui
        Corner(Notif, 8)
        
        local Title = Create("TextLabel")
        Title.Size = UDim2.new(1, -20, 0, 20)
        Title.Position = UDim2.new(0, 10, 0, 5)
        Title.BackgroundTransparency = 1
        Title.Text = config.Title or "Notification"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamBold
        Title.TextSize = 14
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = Notif
        
        local Content = Create("TextLabel")
        Content.Size = UDim2.new(1, -20, 0, 20)
        Content.Position = UDim2.new(0, 10, 0, 25)
        Content.BackgroundTransparency = 1
        Content.Text = config.Content or ""
        Content.TextColor3 = Theme.SubText
        Content.Font = Enum.Font.GothamMedium
        Content.TextSize = 12
        Content.TextXAlignment = Enum.TextXAlignment.Left
        Content.Parent = Notif
        
        Notif.Position = UDim2.new(1, 10, 1, -60)
        Tween(Notif, {Position = UDim2.new(1, -250, 1, -60)}, 0.3)
        
        task.wait(config.Duration or 3)
        Tween(Notif, {Position = UDim2.new(1, 10, 1, -60), BackgroundTransparency = 1}, 0.3)
        task.wait(0.3)
        Notif:Destroy()
    end
    
    return Window
end

return AetherUI
